# ------------------------------
# Keep as many project files as possible.
# Only ignore local/cache files and files that exceed GitHub 100MB limit.
# ------------------------------

# ---- OS / IDE ----
.DS_Store
Thumbs.db
*.swp
*.swo

# ---- Editor local state (safe to regenerate) ----
.vscode/
.idea/

# ---- Python cache/build ----
__pycache__/
*.py[cod]
*.pyd
*.pyo
*.so
*.egg-info/
dist/
build/
.eggs/
pip-wheel-metadata/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---- Virtual environments / local secrets ----
.venv/
venv/
env/
.conda/
*.conda
.env
.env.*

# ---- Logs / temp ----
*.log
*.tmp
*.cache

# ---- Files over GitHub hard limit (>100MB) ----
assets/smplx/SMPLX_FEMALE.npz
assets/smplx/SMPLX_MALE.npz
assets/smplx/SMPLX_NEUTRAL.npz

# ---- Model checkpoints / weights (usually >100MB) ----
assets/checkpoints/
third_party/PyMAF-X/data/pretrained_model/
third_party/PyMAF-X/data/smpl/SMPLX_FEMALE.npz
third_party/PyMAF-X/data/smpl/SMPLX_MALE.npz
third_party/PyMAF-X/data/smpl/SMPLX_NEUTRAL.npz
third_party/PyMAF-X/data/smpl/SMPLX_NEUTRAL_2020.npz

# Common large weight formats
*.ckpt
*.pth
*.pt
*.pth.tar
